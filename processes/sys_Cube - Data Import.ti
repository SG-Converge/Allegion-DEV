nRecCount = nRecCount + 1;
#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****


LogOutput( 'INFO', Expand( '%sProcessName%: [%nRecCount%] records loaded into cube [%sCubeName%] from file [%sFilename%]' ) );

If( bDebug = 1 );
    TextOutput( sLogFile, Expand( '[%nRecCount%] records loaded into cube [%sCubeName%]' ) );
EndIf;

# --- If multi-threading control is needed, then create the semaphore file
# --- that must be tracked by the parent process.
If( sSemaphoreFilename @<> '' );
    TextOutput( sSemaphoreFilename, TIMST( NOW, '\Y-\m-\d \h:\i:\s' ) );
EndIf;
#endregion