#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****


#==============================================================================
#                       Export Cost Leverage
#
#  This process creates the fifteen monthly Cost Leverage files used for
#  Actual, Forecast, and AOP reporting. The file populations and layouts
#  follow the approved Finance requirements and representative files.
#
#
#    Date        WHO  Description
#  ----------    ---  ---------------------------------------------------------
#  07/29/2026    SWG  Created.
#
#==============================================================================


#==============================================================================
#                           CONFIGURATION SECTION
#==============================================================================
sUser = TM1User();
sProcessName = GetProcessName();
sDateStamp = TIMST( NOW, '\Y-\m-\d' );
sTimeStamp = TIMST( NOW, '\Y-\m-\d (\h.\i.\s)' );
sUniqueID = NumberToString( INT( RAND() * 10000 ) );
sUniqueName = Expand( '%sProcessName%_%sTimeStamp%_%sUniqueID%' );
sTempName = Expand( '_tmp_%sUniqueName%' );

# --- Static Values
ERROR = 1; WARN = 2; STATS = 3;
INFO = 4; DEBUG = 5; TRACE = 6;
TRUE = 1; FALSE = 0;
LF = CHAR(10);
TAB = CHAR(9);

# --- Default Settings
nDataRecCount = 0;
nFileRecCount = 0;

# --- Cubes
sConfigCube = 'sys.Config';
sProcessesCube = 'sys.Process Stats';
sGlobalCube = 'Global Assumptions';
sSourceCube = 'PL Reporting';

# --- Dimensions
sProductDim  = 'Product';
sPerioddim   = 'Period';
sScenarioDim = 'Scenario';

# --- Source members
sActualScenario = 'Actual';
sForecastScenario = 'Working Forecast';
sAOPScenario = 'Working AOP';
sCurrency = 'USD';
sMeasure = 'Reported Amount';

# --- Output members
sActualOutputScenario = 'ACTUAL';
sAOPOutputScenario = 'AOP';
sFinalVersion = 'Final';
sWorkingVersion = 'Working';
sReportingView = 'As_Loaded';

# --- Selector groups
sMainFileEntities = '|80010035|80010040|80010060|80010080|80010100|80030010|80030020|80030030|80030040'
    | '|80030050|80030060|80040010|80040020|80050010|80060010|80060050|80080010|81040030|81040050'
    | '|8117|8123|81290010|81290020|81290030|8143|8416|91160040|91160050|80150211|80150311|81300010'
    | '|80010950|81500010|81510010|';
sRSSCOMMFileEntities = '|80010090|81040040|80010070|81040020|';
sExitsAccyFileEntity = '80010035';
sRSSProductRoot = 'RSSSECURITY';
sCOMMProductRoot = 'SSECTOR';
sExitsProductRoot = 'ALT_PROD_EXITS';
sAccyProductRoot = 'ALT_PROD_ACCY';


#==============================================================================
#                               LOGGING SECTION
#==============================================================================

# --- Setup Logging
nLogLevel = CellGetN( sProcessesCube, sProcessName, 'Logging Level' );
sLogDir = CellGetS( sConfigCube, 'Log Directory', 'String' );
sLogFile = sLogDir | sProcessName | '.log';

SetOutputEscapeDoubleQuote( sLogFile, TRUE );
bUseTemporaryObjects = If( nLogLevel >= DEBUG, FALSE, TRUE );

# --- Append to an existing process log
If( FileExists( sLogFile ) = TRUE );
    ASCIIOutputOpen( sLogFile, FILE_OPEN_APPEND() );
EndIf;

# --- Log startup
If( nLogLevel >= INFO );
    sLogLevel = 'INFO';
    sMessage = 'Started';
    ASCIIOutput( sLogFile, sLogLevel | TAB | sMessage );
EndIf;

# --- Report how the script was executed
If( nLogLevel >= DEBUG );
    sLogLevel = 'DEBUG';
    sMessage = Expand( '%LF%
        ======================================================================== %LF%
                        %sProcessName% %LF%
        ======================================================================== %LF%
        Executed by [%sUser%] %LF%
              pOutputDirectory = [%pOutputDirectory%] %LF%
        ======================================================================== %LF%
    ' );
    ASCIIOutput( sLogFile, sLogLevel | TAB | sMessage );
EndIf;


#==============================================================================
#                        PARAMETER VALIDATION SECTION
#==============================================================================

# --- Use the parameter only as an explicit override of the configured directory
sOutputDirectory = CellGetS( sConfigCube, 'Cost Leverage Download Directory', 'String' );
If( TRIM( pOutputDirectory ) @<> '' );
    sOutputDirectory = TRIM( pOutputDirectory );
EndIf;

If( sOutputDirectory @= '' );
    sLogLevel = 'ERROR';
    sMessage = 'Cost Leverage Output Directory is not configured and no parameter override was supplied';
    LogOutput( sLogLevel, sMessage );
    If( nLogLevel >= ERROR );
        ASCIIOutput( sLogFile, sLogLevel | TAB | sMessage );
    EndIf;
    ProcessError();
EndIf;

# --- Validate the scenario to export
sExportScenario = pScenario;
If( sExportScenario @<> '' );
    If( DimensionElementExists( sScenarioDim, sExportScenario ) = FALSE );
        sLogLevel = 'ERROR';
        sMessage = Expand( 'Invalid export scenario provided [%pScenario%]' );
        LogOutput( sLogLevel, sMessage );
        If( nLogLevel >= ERROR );
            ASCIIOutput( sLogFile, sLogLevel | TAB | sMessage );
        EndIf;
        ProcessError();
    EndIf;
EndIf;

# --- Capture / calculate the forecast start period
sForecastStartPeriod = CellGetS( sGlobalCube, 'Forecast Start Period', 'String' ); 
If( pPeriod @<> '' );
    If( DimensionElementExists( sPeriodDim, pPeriod ) = FALSE );
        sLogLevel = 'ERROR';
        sMessage = Expand( 'Invalid Forecast start period provided [%pPeriod%]' );
        LogOutput( sLogLevel, sMessage );
        If( nLogLevel >= ERROR );
            ASCIIOutput( sLogFile, sLogLevel | TAB | sMessage );
        EndIf;
        ProcessError();
    EndIf;
    
    sForecastStartPeriod = pPeriod;
EndIf;


#==============================================================================
#                           PROCESS LOGIC SECTION
#==============================================================================

# --- Capture the forecast start year and month separately
sForecastYear = SUBST( sForecastStartPeriod, 1, 4 );
sForecastStartMonth = SUBST( sForecastStartPeriod, 6, 2 );

# --- Determine what files to export
If( sExportScenario @= '' );
    bExportActual = TRUE;
    bExportForecast = TRUE;
    bExportAOP = TRUE;
Else;    
    bExportActual = If( SCAN( 'actual', LOWER( sExportScenario ) ) > 0, TRUE, FALSE );
    bExportForecast = If( SCAN( 'forecast', LOWER( sExportScenario ) ) > 0, TRUE, FALSE );
    bExportAOP = If( SCAN( 'aop', LOWER( sExportScenario ) ) > 0, TRUE, FALSE );
EndIf;

#------------------------------------------------------------------------------
# --- Resolve periods and years from Global Assumptions.
#------------------------------------------------------------------------------
sActualPeriod = CellGetS( sGlobalCube, 'HFM Load Period', 'String' );
sActualYear = SUBST( sActualPeriod, 1, 4 );
sAOPYear = CellGetS( sGlobalCube, 'Working AOP Start Year', 'String' );

sActualYearLabel = 'FY' | SUBST( sActualYear, 3, 2 );
sForecastYearLabel = 'FY' | SUBST( sForecastYear, 3, 2 );
sAOPYearLabel = 'FY' | SUBST( sAOPYear, 3, 2 );

nActualMonth = NUMBR( SUBST( sActualPeriod, 6, 2 ) );
sMonthNames = 'JanFebMarAprMayJunJulAugSepOctNovDec';
sActualMonthName = SUBST( sMonthNames, ( nActualMonth - 1 ) * 3 + 1, 3 );

nForecastStartMonth = NUMBR( sForecastStartMonth );
If( nForecastStartMonth >= 2 & nForecastStartMonth <= 4 );
    sForecastOutputScenario = 'FCST_02_10';
ElseIf( nForecastStartMonth >= 5 & nForecastStartMonth <= 7 );
    sForecastOutputScenario = 'FCST_05_07';
Else;
    sForecastOutputScenario = 'FCST_08_04';
EndIf;

# --- Normalize output directory
sLastCharacter = SUBST( sOutputDirectory, LONG( sOutputDirectory ), 1 );
If( sLastCharacter @<> '\' & sLastCharacter @<> '/' );
    sOutputDirectory = sOutputDirectory | '/';
EndIf;

#------------------------------------------------------------------------------
# --- Resolve the fifteen output files.
#------------------------------------------------------------------------------
sActualFile = sOutputDirectory | 'CL_Actual.csv';
sActualRSSFile = sOutputDirectory | 'CL_Actual_RSS.csv';
sActualCOMMFile = sOutputDirectory | 'CL_Actual_COMM.csv';
sActualExitsFile = sOutputDirectory | 'CL_Actual_Exits.csv';
sActualAccyFile = sOutputDirectory | 'CL_Actual_Accy.csv';

sForecastFile = sOutputDirectory | 'CL_Forecast.csv';
sForecastRSSFile = sOutputDirectory | 'CL_Forecast_RSS.csv';
sForecastCOMMFile = sOutputDirectory | 'CL_Forecast_COMM.csv';
sForecastExitsFile = sOutputDirectory | 'CL_Forecast_Exits.csv';
sForecastAccyFile = sOutputDirectory | 'CL_Forecast_Accy.csv';

sAOPFile = sOutputDirectory | 'CL_AOP.csv';
sAOPRSSFile = sOutputDirectory | 'CL_AOP_RSS.csv';
sAOPCOMMFile = sOutputDirectory | 'CL_AOP_COMM.csv';
sAOPExitsFile = sOutputDirectory | 'CL_AOP_Exits.csv';
sAOPAccyFile = sOutputDirectory | 'CL_AOP_Accy.csv';

# --- Lines are assembled explicitly to reproduce the representative CSV format
DatasourceASCIIDelimiter = ',';
DatasourceASCIIQuoteCharacter = '';

sHeader1 = '"Years","Version","Scenario","Currency","Function","Product","Entity","Account","ReportingView","Period"';
sActualHeader2 = '"' | sActualMonthName | '"';
sPlanHeader2 = '"BegBalance","Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec","NoPeriod","RF-YTD2"';

If( bExportActual = TRUE );
    If( FileExists( sActualFile ) = TRUE ); ASCIIDelete( sActualFile ); EndIf;
    If( FileExists( sActualRSSFile ) = TRUE ); ASCIIDelete( sActualRSSFile ); EndIf;
    If( FileExists( sActualCOMMFile ) = TRUE ); ASCIIDelete( sActualCOMMFile ); EndIf;
    If( FileExists( sActualExitsFile ) = TRUE ); ASCIIDelete( sActualExitsFile ); EndIf;
    If( FileExists( sActualAccyFile ) = TRUE ); ASCIIDelete( sActualAccyFile ); EndIf;
EndIf;

If( bExportForecast = TRUE );
    If( FileExists( sForecastFile ) = TRUE ); ASCIIDelete( sForecastFile ); EndIf;
    If( FileExists( sForecastRSSFile ) = TRUE ); ASCIIDelete( sForecastRSSFile ); EndIf;
    If( FileExists( sForecastCOMMFile ) = TRUE ); ASCIIDelete( sForecastCOMMFile ); EndIf;
    If( FileExists( sForecastExitsFile ) = TRUE ); ASCIIDelete( sForecastExitsFile ); EndIf;
    If( FileExists( sForecastAccyFile ) = TRUE ); ASCIIDelete( sForecastAccyFile ); EndIf;
EndIf;

If( bExportAOP = TRUE );
    If( FileExists( sAOPFile ) = TRUE ); ASCIIDelete( sAOPFile ); EndIf;
    If( FileExists( sAOPRSSFile ) = TRUE ); ASCIIDelete( sAOPRSSFile ); EndIf;
    If( FileExists( sAOPCOMMFile ) = TRUE ); ASCIIDelete( sAOPCOMMFile ); EndIf;
    If( FileExists( sAOPExitsFile ) = TRUE ); ASCIIDelete( sAOPExitsFile ); EndIf;
    If( FileExists( sAOPAccyFile ) = TRUE ); ASCIIDelete( sAOPAccyFile ); EndIf;
EndIf;

#------------------------------------------------------------------------------
# --- Build one source view using Year and Reported Amount as record drivers.
#------------------------------------------------------------------------------
sViewMDX = Expand( '%LF%
    WITH %LF%
        SET ScenarioSet AS { %LF%
            [Scenario].[Scenario].[%sActualScenario%], %LF%
            [Scenario].[Scenario].[%sForecastScenario%], %LF%
            [Scenario].[Scenario].[%sAOPScenario%] %LF%
        } %LF%
        SET PeriodSet AS DISTINCT( { %LF%
            TM1FilterByLevel( DESCENDANTS( [Period].[Period].[%sActualYear%] ), 0 ), %LF%
            TM1FilterByLevel( DESCENDANTS( [Period].[Period].[%sForecastYear%]), 0 ), %LF%
            TM1FilterByLevel( DESCENDANTS( [Period].[Period].[%sAOPYear%]), 0 ) %LF%
        } ) %LF%
        SET CurrencySet AS { [Currency].[Currency].[%sCurrency%] } %LF%
        SET EntitySet AS { %LF%
            [Entity].[Entity].[80010035], [Entity].[Entity].[80010040], [Entity].[Entity].[80010060], %LF%
            [Entity].[Entity].[80010080], [Entity].[Entity].[80010100], [Entity].[Entity].[80030010], %LF%
            [Entity].[Entity].[80030020], [Entity].[Entity].[80030030], [Entity].[Entity].[80030040], %LF%
            [Entity].[Entity].[80030050], [Entity].[Entity].[80030060], [Entity].[Entity].[80040010], %LF%
            [Entity].[Entity].[80040020], [Entity].[Entity].[80050010], [Entity].[Entity].[80060010], %LF%
            [Entity].[Entity].[80060050], [Entity].[Entity].[80080010], [Entity].[Entity].[81040030], %LF%
            [Entity].[Entity].[81040050], [Entity].[Entity].[8117], [Entity].[Entity].[8123], %LF%
            [Entity].[Entity].[81290010], [Entity].[Entity].[81290020], [Entity].[Entity].[81290030], %LF%
            [Entity].[Entity].[8143], [Entity].[Entity].[8416], [Entity].[Entity].[91160040], %LF%
            [Entity].[Entity].[91160050], [Entity].[Entity].[80150211], [Entity].[Entity].[80150311], %LF%
            [Entity].[Entity].[81300010], [Entity].[Entity].[80010950], [Entity].[Entity].[81500010], %LF%
            [Entity].[Entity].[81510010], [Entity].[Entity].[80010090], [Entity].[Entity].[81040040], %LF%
            [Entity].[Entity].[80010070], [Entity].[Entity].[81040020] %LF%
        } %LF%
        SET ProductSet AS TM1FilterByLevel( TM1SubsetAll( [Product] ), 0 ) %LF%
        SET FunctionSet AS TM1FilterByLevel( TM1SubsetAll( [Function] ), 0 ) %LF%
        SET AccountSet AS DISTINCT( %LF%
            { [PL Account].[PL Account].[411100] } %LF%
            + TM1FilterByLevel( DESCENDANTS( [PL Account].[PL Account].[500000] ), 0 ) %LF%
            + TM1FilterByLevel( DESCENDANTS( [PL Account].[PL Account].[600000] ), 0 ) %LF%
        ) %LF%
        SET MeasureSet AS { [PL Reporting Measure].[PL Reporting Measure].[%sMeasure%] } %LF%

    SELECT %LF%
        MeasureSet ON 0, %LF%
        NON EMPTY ScenarioSet * PeriodSet * CurrencySet * EntitySet %LF%
            * ProductSet * FunctionSet * AccountSet ON 1 %LF%

    FROM [%sSourceCube%] %LF%
' );

sViewName = sTempName | ' - Cost Leverage Source';
If( nLogLevel >= DEBUG );
    sLogLevel = 'DEBUG';
    sMessage = Expand( 'Source view [%sViewName%]:%LF%%sViewMDX%' );
    ASCIIOutput( sLogFile, sLogLevel | TAB | sMessage );
EndIf;

ViewCreateByMDX( sSourceCube, sViewName, sViewMDX, bUseTemporaryObjects );
ViewExtractSkipRuleValuesSet( sSourceCube, sViewName, FALSE );
ViewExtractSkipZeroesSet( sSourceCube, sViewName, TRUE );
ViewExtractSkipCalcsSet( sSourceCube, sViewName, TRUE );

DatasourceNameForServer = sSourceCube;
DatasourceCubeView = sViewName;
#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
nDataRecCount = nDataRecCount + 1;

If( bExportActual = TRUE & nDataRecCount = 1 );
    ASCIIOutput( sActualFile, sHeader1 );
    ASCIIOutput( sActualFile, sActualHeader2 );
    ASCIIOutput( sActualRSSFile, sHeader1 );
    ASCIIOutput( sActualRSSFile, sActualHeader2 );
    ASCIIOutput( sActualCOMMFile, sHeader1 );
    ASCIIOutput( sActualCOMMFile, sActualHeader2 );
    ASCIIOutput( sActualExitsFile, sHeader1 );
    ASCIIOutput( sActualExitsFile, sActualHeader2 );
    ASCIIOutput( sActualAccyFile, sHeader1 );
    ASCIIOutput( sActualAccyFile, sActualHeader2 );
EndIf;

If( bExportForecast = TRUE & nDataRecCount = 1 );
    ASCIIOutput( sForecastFile, sHeader1 );
    ASCIIOutput( sForecastFile, sPlanHeader2 );
    ASCIIOutput( sForecastRSSFile, sHeader1 );
    ASCIIOutput( sForecastRSSFile, sPlanHeader2 );
    ASCIIOutput( sForecastCOMMFile, sHeader1 );
    ASCIIOutput( sForecastCOMMFile, sPlanHeader2 );
    ASCIIOutput( sForecastExitsFile, sHeader1 );
    ASCIIOutput( sForecastExitsFile, sPlanHeader2 );
    ASCIIOutput( sForecastAccyFile, sHeader1 );
    ASCIIOutput( sForecastAccyFile, sPlanHeader2 );
EndIf;

If( bExportAOP = TRUE & nDataRecCount = 1 );
    ASCIIOutput( sAOPFile, sHeader1 );
    ASCIIOutput( sAOPFile, sPlanHeader2 );
    ASCIIOutput( sAOPRSSFile, sHeader1 );
    ASCIIOutput( sAOPRSSFile, sPlanHeader2 );
    ASCIIOutput( sAOPCOMMFile, sHeader1 );
    ASCIIOutput( sAOPCOMMFile, sPlanHeader2 );
    ASCIIOutput( sAOPExitsFile, sHeader1 );
    ASCIIOutput( sAOPExitsFile, sPlanHeader2 );
    ASCIIOutput( sAOPAccyFile, sHeader1 );
    ASCIIOutput( sAOPAccyFile, sPlanHeader2 );
EndIf;

# --- Copy incoming datasource values to typed working variables
sMeasure  = inMeasure;
sScenario = inScenario;
sPeriod   = inPeriod;
sCurrency = inCurrency;
sEntity   = inEntity;
sProduct  = inProduct;
sFunction = inFunction;
sAccount  = inAccount;
nValue    = inValue;

sYear     = SUBST( sPeriod, 1, 4 );

# --- Each source record is a Year / Reported Amount driver for one output row
If( bExportActual = TRUE & sScenario @= sActualScenario & sPeriod @= sActualPeriod );
    # --- Get the monthly values
    nAct = CellGetN( sSourceCube, sScenario, sActualPeriod, sCurrency, sEntity, sProduct, sFunction, sAccount, sMeasure );

    # --- Convert them to strings for file output
    sAct = NumberToString( nAct );

    # --- Prepare the output line
    sLine = '"' | sActualYearLabel | '","' | sFinalVersion | '","' | sActualOutputScenario
        | '","' | sCurrency | '","' | sFunction | '","' | sProduct
        | '","' | sEntity | '","' | sAccount | '","' | sReportingView | '",' | sAct;

    # --- Set the export files
    sMainFile = sActualFile;
    sRSSFile = sActualRSSFile;
    sCOMMFile = sActualCOMMFile;
    sExitsFile = sActualExitsFile;
    sAccyFile = sActualAccyFile;

ElseIf( bExportForecast = TRUE & sScenario @= sForecastScenario & sYear @= sForecastYear );
    # --- Get the monthly values
    nJan = CellGetN( sSourceCube, sScenario, sForecastYear | '-01', sCurrency, sEntity, sProduct, sFunction, sAccount, sMeasure );
    nFeb = CellGetN( sSourceCube, sScenario, sForecastYear | '-02', sCurrency, sEntity, sProduct, sFunction, sAccount, sMeasure );
    nMar = CellGetN( sSourceCube, sScenario, sForecastYear | '-03', sCurrency, sEntity, sProduct, sFunction, sAccount, sMeasure );
    nApr = CellGetN( sSourceCube, sScenario, sForecastYear | '-04', sCurrency, sEntity, sProduct, sFunction, sAccount, sMeasure );
    nMay = CellGetN( sSourceCube, sScenario, sForecastYear | '-05', sCurrency, sEntity, sProduct, sFunction, sAccount, sMeasure );
    nJun = CellGetN( sSourceCube, sScenario, sForecastYear | '-06', sCurrency, sEntity, sProduct, sFunction, sAccount, sMeasure );
    nJul = CellGetN( sSourceCube, sScenario, sForecastYear | '-07', sCurrency, sEntity, sProduct, sFunction, sAccount, sMeasure );
    nAug = CellGetN( sSourceCube, sScenario, sForecastYear | '-08', sCurrency, sEntity, sProduct, sFunction, sAccount, sMeasure );
    nSep = CellGetN( sSourceCube, sScenario, sForecastYear | '-09', sCurrency, sEntity, sProduct, sFunction, sAccount, sMeasure );
    nOct = CellGetN( sSourceCube, sScenario, sForecastYear | '-10', sCurrency, sEntity, sProduct, sFunction, sAccount, sMeasure );
    nNov = CellGetN( sSourceCube, sScenario, sForecastYear | '-11', sCurrency, sEntity, sProduct, sFunction, sAccount, sMeasure );
    nDec = CellGetN( sSourceCube, sScenario, sForecastYear | '-12', sCurrency, sEntity, sProduct, sFunction, sAccount, sMeasure );

    # --- Convert them to strings for file output
    sJan = NumberToString( nJan );  sFeb = NumberToString( nFeb );  sMar = NumberToString( nMar );  sApr = NumberToString( nApr );
    sMay = NumberToString( nMay );  sJun = NumberToString( nJun );  sJul = NumberToString( nJul );  sAug = NumberToString( nAug );
    sSep = NumberToString( nSep );  sOct = NumberToString( nOct );  sNov = NumberToString( nNov );  sDec = NumberToString( nDec );

    # --- Prepare the output line
    sLine = '"' | sForecastYearLabel | '","' | sWorkingVersion | '","' | sForecastOutputScenario
        | '","' | sCurrency | '","' | sFunction | '","' | sProduct
        | '","' | sEntity | '","' | sAccount | '","' | sReportingView | '",#Mi,'
        | sJan | ',' | sFeb | ',' | sMar | ',' | sApr | ',' | sMay | ',' | sJun
        | ',' | sJul | ',' | sAug | ',' | sSep | ',' | sOct | ',' | sNov | ',' | sDec;

    # --- Set the export files
    sMainFile = sForecastFile;
    sRSSFile = sForecastRSSFile;
    sCOMMFile = sForecastCOMMFile;
    sExitsFile = sForecastExitsFile;
    sAccyFile = sForecastAccyFile;

ElseIf( bExportAOP = TRUE & sScenario @= sAOPScenario & sYear @= sAOPYear );
    # --- Get the monthly values
    nJan = CellGetN( sSourceCube, sScenario, sAOPYear | '-01', sCurrency, sEntity, sProduct, sFunction, sAccount, sMeasure );
    nFeb = CellGetN( sSourceCube, sScenario, sAOPYear | '-02', sCurrency, sEntity, sProduct, sFunction, sAccount, sMeasure );
    nMar = CellGetN( sSourceCube, sScenario, sAOPYear | '-03', sCurrency, sEntity, sProduct, sFunction, sAccount, sMeasure );
    nApr = CellGetN( sSourceCube, sScenario, sAOPYear | '-04', sCurrency, sEntity, sProduct, sFunction, sAccount, sMeasure );
    nMay = CellGetN( sSourceCube, sScenario, sAOPYear | '-05', sCurrency, sEntity, sProduct, sFunction, sAccount, sMeasure );
    nJun = CellGetN( sSourceCube, sScenario, sAOPYear | '-06', sCurrency, sEntity, sProduct, sFunction, sAccount, sMeasure );
    nJul = CellGetN( sSourceCube, sScenario, sAOPYear | '-07', sCurrency, sEntity, sProduct, sFunction, sAccount, sMeasure );
    nAug = CellGetN( sSourceCube, sScenario, sAOPYear | '-08', sCurrency, sEntity, sProduct, sFunction, sAccount, sMeasure );
    nSep = CellGetN( sSourceCube, sScenario, sAOPYear | '-09', sCurrency, sEntity, sProduct, sFunction, sAccount, sMeasure );
    nOct = CellGetN( sSourceCube, sScenario, sAOPYear | '-10', sCurrency, sEntity, sProduct, sFunction, sAccount, sMeasure );
    nNov = CellGetN( sSourceCube, sScenario, sAOPYear | '-11', sCurrency, sEntity, sProduct, sFunction, sAccount, sMeasure );
    nDec = CellGetN( sSourceCube, sScenario, sAOPYear | '-12', sCurrency, sEntity, sProduct, sFunction, sAccount, sMeasure );

    # --- Convert them to strings for file output
    sJan = NumberToString( nJan );  sFeb = NumberToString( nFeb );  sMar = NumberToString( nMar );  sApr = NumberToString( nApr );
    sMay = NumberToString( nMay );  sJun = NumberToString( nJun );  sJul = NumberToString( nJul );  sAug = NumberToString( nAug );
    sSep = NumberToString( nSep );  sOct = NumberToString( nOct );  sNov = NumberToString( nNov );  sDec = NumberToString( nDec );

    # --- Prepare the output line
    sLine = '"' | sAOPYearLabel | '","' | sWorkingVersion | '","' | sAOPOutputScenario
        | '","' | sCurrency | '","' | sFunction | '","' | sProduct
        | '","' | sEntity | '","' | sAccount | '","' | sReportingView | '",#Mi,'
        | sJan | ',' | sFeb | ',' | sMar | ',' | sApr | ',' | sMay | ',' | sJun
        | ',' | sJul | ',' | sAug | ',' | sSep | ',' | sOct | ',' | sNov | ',' | sDec;

    # --- Set the export files
    sMainFile = sAOPFile;
    sRSSFile = sAOPRSSFile;
    sCOMMFile = sAOPCOMMFile;
    sExitsFile = sAOPExitsFile;
    sAccyFile = sAOPAccyFile;

Else;
    ItemSkip;
EndIf;


# --- Route the row using only selector groups proven identical in the requirements
If( SCAN( '|' | sEntity | '|', sMainFileEntities ) > 0 );
    ASCIIOutput( sMainFile, sLine );
    nFileRecCount = nFileRecCount + 1;
EndIf;

If( SCAN( '|' | sEntity | '|', sRSSCOMMFileEntities ) > 0 );
    If( ELISANC( sProductDim, sRSSProductRoot, sProduct ) = TRUE );
        ASCIIOutput( sRSSFile, sLine );
        nFileRecCount = nFileRecCount + 1;
    EndIf;

    If( ELISANC( sProductDim, sCOMMProductRoot, sProduct ) = TRUE );
        ASCIIOutput( sCOMMFile, sLine );
        nFileRecCount = nFileRecCount + 1;
    EndIf;
EndIf;

If( sEntity @= sExitsAccyFileEntity );
    If( ELISANC( sProductDim, sExitsProductRoot, sProduct ) = TRUE );
        ASCIIOutput( sExitsFile, sLine );
        nFileRecCount = nFileRecCount + 1;
    EndIf;

    If( ELISANC( sProductDim, sAccyProductRoot, sProduct ) = TRUE );
        ASCIIOutput( sAccyFile, sLine );
        nFileRecCount = nFileRecCount + 1;
    EndIf;
EndIf;


If( nLogLevel >= TRACE );
    sLogLevel = 'TRACE';
    sMessage = 'Exported Year / Reported Amount driver record';
    ASCIIOutput( sLogFile, sLogLevel | TAB | sMessage | TAB | sScenario | TAB | sPeriod
        | TAB | sEntity | TAB | sProduct | TAB | sFunction | TAB | sAccount );
EndIf;
#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****

# --- Append to the log
If( FileExists( sLogFile ) = TRUE );
    ASCIIOutputOpen( sLogFile, FILE_OPEN_APPEND() );
EndIf;

# --- Log measured results
If( nLogLevel >= STATS );
    sLogLevel = 'STATS';
    sMessage = 'Cost Leverage export statistics';
    ASCIIOutput( sLogFile, sLogLevel | TAB | sMessage | TAB | 'Source Records='
        | NumberToString( nDataRecCount ) | TAB | 'File Records=' | NumberToString( nFileRecCount )
        | TAB | 'Files Created=15' );
EndIf;

# --- Log completion
If( nLogLevel >= INFO );
    sLogLevel = 'INFO';
    sMessage = 'Completed';
    ASCIIOutput( sLogFile, sLogLevel | TAB | sMessage );
EndIf;
#endregion