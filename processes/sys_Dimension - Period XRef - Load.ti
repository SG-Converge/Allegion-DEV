#region Prolog

#==============================================================================
#        sys_Dimension - Period XRef - Load 
#
#  This script will use a pre-built calendar file from a python script and
#  generate/update a period dimension based on the settings selected.  
#
#  REQUIREMENTS:
#       CSV file generated by the GenerateCalendar.py script.
#
#
#      Date    WHO  Description
#  ----------  ---  -----------------------------------------------------------
#  06/20/2024  SWG  Created.
#
#==============================================================================

#==============================================================================
#                           CONFIGURATION SECTION
#==============================================================================
sUser = TM1User();
sProcessName = GetProcessName();
sTimeStamp = TIMST( NOW, '\Y-\m-\d(\h\i\s)' );
sUniqueID = NumbertoString(INT(RAND()*10000));
sUniqueName = Expand('%sProcessName%_%sTimeStamp%_%sUniqueID%' );
sTempName = Expand('_tmp_%sUniqueName%' );

sLogPath = './Logs/Processes/';
sLogFile = sLogPath | sUniqueName | '.log';

# --- Values
TRUE = 1;
FALSE = 0;
bDebug = FALSE;
nErrorCount = 0;

#==============================================================================
#                        PARAMETER VALIDATION SECTION
#==============================================================================

# --- Capture the name of the cross reference dimension to create
sDimName = pDimName;

#==============================================================================
#                           PROCESS LOGIC SECTION
#==============================================================================

#------------------------------------------------------------------------------
#          Build the dimension, hierarchies and attributes
#------------------------------------------------------------------------------
# --- Recreate Dimension
If( DimensionExists( sDimName ) = 0 );
    DimensionCreate( sDimName );
EndIf;

DimensionDeleteAllElements( sDimName );

ElementAttrInsert( sDimName, sDimName, '', 'Period', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Period', 'Period Type', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Period Type', 'Short Name', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Short Name', 'Long Name', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Long Name', 'Period Days', 'N' );
ElementAttrInsert( sDimName, sDimName, 'Period Days', 'Period Weeks', 'N' );
ElementAttrInsert( sDimName, sDimName, 'Period Weeks', 'Period Months', 'N' );
ElementAttrInsert( sDimName, sDimName, 'Period Months', 'Period Quarters', 'N' );
ElementAttrInsert( sDimName, sDimName, 'Period Quarters', 'Period Beginning Day', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Period Beginning Day', 'Period Ending Day', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Period Ending Day', 'Period Beginning Week', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Period Beginning Week', 'Period Ending Week', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Period Ending Week', 'Period Beginning Month', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Period Beginning Month', 'Period Ending Month', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Period Ending Month', 'Period Beginning Quarter', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Period Beginning Quarter', 'Period Ending Quarter', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Period Ending Quarter', 'Period Beginning Half', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Period Beginning Half', 'Period Ending Half', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Period Ending Half', 'Period Beginning Year', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Period Beginning Year', 'Period Ending Year', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Period Ending Year', 'Period Prior', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Period Prior', 'Period Next', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Period Next', 'Period Prior Day', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Period Prior Day', 'Period Next Day', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Period Next Day', 'Period Prior Week', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Period Prior Week', 'Period Next Week', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Period Next Week', 'Period Prior Month', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Period Prior Month', 'Period Next Month', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Period Next Month', 'Period Prior Quarter', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Period Prior Quarter', 'Period Next Quarter', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Period Next Quarter', 'Period Prior Half', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Period Prior Half', 'Period Next Half', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Period Next Half', 'Period Prior Year', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Period Prior Year', 'Period Next Year', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Period Next Year', 'Calendar Start Date', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Calendar Start Date', 'Calendar End Date', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Calendar End Date', 'Calendar Day Of Week', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Calendar Day Of Week', 'Calendar Day Of Month', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Calendar Day Of Month', 'Calendar Day Of Quarter', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Calendar Day Of Quarter', 'Calendar Day Of Year', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Calendar Day Of Year', 'Calendar Week Of Month', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Calendar Week Of Month', 'Calendar Week Of Quarter', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Calendar Week Of Quarter', 'Calendar Week Of Year', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Calendar Week Of Year', 'Calendar Month Short', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Calendar Month Short', 'Calendar Month Long', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Calendar Month Long', 'Calendar Month Of Quarter', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Calendar Month Of Quarter', 'Calendar Month Of Year', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Calendar Month Of Year', 'Calendar Quarter Of Year', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Calendar Quarter Of Year', 'Calendar Half Of Year', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Calendar Half Of Year', 'Calendar Year', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Calendar Year', 'Fiscal Week', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Fiscal Week', 'Fiscal Month', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Fiscal Month', 'Fiscal Quarter', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Fiscal Quarter', 'Fiscal Half', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Fiscal Half', 'Fiscal Year', 'S' );
ElementAttrInsert( sDimName, sDimName, 'Fiscal Year', 'MFG Week', 'S' );
ElementAttrInsert( sDimName, sDimName, 'MFG Week', 'MFG Month', 'S' );
ElementAttrInsert( sDimName, sDimName, 'MFG Month', 'MFG Quarter', 'S' );
ElementAttrInsert( sDimName, sDimName, 'MFG Quarter', 'MFG Half', 'S' );
ElementAttrInsert( sDimName, sDimName, 'MFG Half', 'MFG Year', 'S' );
ElementAttrInsert( sDimName, sDimName, 'MFG Year', 'TM1 Serial', 'N' );
ElementAttrInsert( sDimName, sDimName, 'TM1 Serial', 'First Day TM1 Serial', 'N' );
ElementAttrInsert( sDimName, sDimName, 'First Day TM1 Serial', 'Last Day TM1 Serial', 'N' );
ElementAttrInsert( sDimName, sDimName, 'Last Day TM1 Serial', 'Excel Serial', 'N' );
ElementAttrInsert( sDimName, sDimName, 'Excel Serial', 'First Day Excel Serial', 'N' );
ElementAttrInsert( sDimName, sDimName, 'First Day Excel Serial', 'Last Day Excel Serial', 'N' );

#endregion
#region Metadata

DimensionElementInsert( sDimName, '', period, 'N' );


#endregion
#region Data

sPeriod = period;

ElementAttrPutS( period, sDimName, sDimName, sPeriod,  'Period');
ElementAttrPutS( period_type, sDimName, sDimName, sPeriod, 'Period Type');
ElementAttrPutS( short_name, sDimName, sDimName, sPeriod, 'Short Name');
ElementAttrPutS( long_name, sDimName, sDimName, sPeriod, 'Long Name');
ElementAttrPutN( period_days, sDimName, sDimName, sPeriod, 'Period Days');
ElementAttrPutN( period_weeks, sDimName, sDimName, sPeriod, 'Period Weeks');
ElementAttrPutN( period_months, sDimName, sDimName, sPeriod, 'Period Months');
ElementAttrPutN( period_quarters, sDimName, sDimName, sPeriod, 'Period Quarters');
ElementAttrPutS( period_beginning_day, sDimName, sDimName, sPeriod, 'Period Beginning Day');
ElementAttrPutS( period_ending_day, sDimName, sDimName, sPeriod, 'Period Ending Day');
ElementAttrPutS( period_beginning_week, sDimName, sDimName, sPeriod,  'Period Beginning Week');
ElementAttrPutS( period_ending_week, sDimName, sDimName, sPeriod, 'Period Ending Week');
ElementAttrPutS( period_beginning_month, sDimName, sDimName, sPeriod, 'Period Beginning Month');
ElementAttrPutS( period_ending_month, sDimName, sDimName, sPeriod, 'Period Ending Month');
ElementAttrPutS( period_beginning_quarter, sDimName, sDimName, sPeriod, 'Period Beginning Quarter');
ElementAttrPutS( period_ending_quarter, sDimName, sDimName, sPeriod, 'Period Ending Quarter');
ElementAttrPutS( period_beginning_half, sDimName, sDimName, sPeriod, 'Period Beginning Half');
ElementAttrPutS( period_ending_half, sDimName, sDimName, sPeriod, 'Period Ending Half');
ElementAttrPutS( period_beginning_year, sDimName, sDimName, sPeriod, 'Period Beginning Year');
ElementAttrPutS( period_ending_year, sDimName, sDimName, sPeriod, 'Period Ending Year');
ElementAttrPutS( period_prior, sDimName, sDimName, sPeriod, 'Period Prior');
ElementAttrPutS( period_next, sDimName, sDimName, sPeriod, 'Period Next');
ElementAttrPutS( period_prior_day, sDimName, sDimName, sPeriod, 'Period Prior Day');
ElementAttrPutS( period_next_day, sDimName, sDimName, sPeriod, 'Period Next Day');
ElementAttrPutS( period_prior_week, sDimName, sDimName, sPeriod, 'Period Prior Week');
ElementAttrPutS( period_next_week, sDimName, sDimName, sPeriod, 'Period Next Week');
ElementAttrPutS( period_prior_month, sDimName, sDimName, sPeriod, 'Period Prior Month');
ElementAttrPutS( period_next_month, sDimName, sDimName, sPeriod,  'Period Next Month');
ElementAttrPutS( period_prior_quarter, sDimName, sDimName, sPeriod, 'Period Prior Quarter');
ElementAttrPutS( period_next_quarter, sDimName, sDimName, sPeriod, 'Period Next Quarter');
ElementAttrPutS( period_prior_half, sDimName, sDimName, sPeriod, 'Period Prior Half');
ElementAttrPutS( period_next_half, sDimName, sDimName, sPeriod, 'Period Next Half');
ElementAttrPutS( period_prior_year, sDimName, sDimName, sPeriod, 'Period Prior Year');
ElementAttrPutS( period_next_year, sDimName, sDimName, sPeriod, 'Period Next Year');
ElementAttrPutS( calendar_start_date, sDimName, sDimName, sPeriod, 'Calendar Start Date');
ElementAttrPutS( calendar_end_date, sDimName, sDimName, sPeriod, 'Calendar End Date');
ElementAttrPutS( calendar_day_of_week, sDimName, sDimName, sPeriod, 'Calendar Day Of Week');
ElementAttrPutS( calendar_day_of_month, sDimName, sDimName, sPeriod, 'Calendar Day Of Month');
ElementAttrPutS( calendar_day_of_quarter, sDimName, sDimName, sPeriod, 'Calendar Day Of Quarter');
ElementAttrPutS( calendar_day_of_year, sDimName, sDimName, sPeriod, 'Calendar Day Of Year');
ElementAttrPutS( calendar_week_of_month, sDimName, sDimName, sPeriod, 'Calendar Week Of Month');
ElementAttrPutS( calendar_week_of_quarter, sDimName, sDimName, sPeriod, 'Calendar Week Of Quarter');
ElementAttrPutS( calendar_week_of_year, sDimName, sDimName, sPeriod, 'Calendar Week Of Year');
ElementAttrPutS( calendar_month_short, sDimName, sDimName, sPeriod, 'Calendar Month Short');
ElementAttrPutS( calendar_month_long, sDimName, sDimName, sPeriod, 'Calendar Month Long');
ElementAttrPutS( calendar_month_of_quarter, sDimName, sDimName, sPeriod, 'Calendar Month Of Quarter');
ElementAttrPutS( calendar_month_of_year, sDimName, sDimName, sPeriod, 'Calendar Month Of Year');
ElementAttrPutS( calendar_quarter_of_year, sDimName, sDimName, sPeriod, 'Calendar Quarter Of Year');
ElementAttrPutS( calendar_half_of_year, sDimName, sDimName, sPeriod, 'Calendar Half Of Year');
ElementAttrPutS( calendar_year, sDimName, sDimName, sPeriod, 'Calendar Year');
ElementAttrPutS( fiscal_week, sDimName, sDimName, sPeriod, 'Fiscal Week');
ElementAttrPutS( fiscal_month, sDimName, sDimName, sPeriod, 'Fiscal Month');
ElementAttrPutS( fiscal_quarter, sDimName, sDimName, sPeriod, 'Fiscal Quarter');
ElementAttrPutS( fiscal_half, sDimName, sDimName, sPeriod, 'Fiscal Half');
ElementAttrPutS( fiscal_year, sDimName, sDimName, sPeriod, 'Fiscal Year');
ElementAttrPutS( mfg_week, sDimName, sDimName, sPeriod, 'MFG Week');
ElementAttrPutS( mfg_month, sDimName, sDimName, sPeriod, 'MFG Month');
ElementAttrPutS( mfg_quarter, sDimName, sDimName, sPeriod, 'MFG Quarter');
ElementAttrPutS( mfg_half, sDimName, sDimName, sPeriod, 'MFG Half');
ElementAttrPutS( mfg_year, sDimName, sDimName, sPeriod, 'MFG Year');
ElementAttrPutN( tm1_serial, sDimName, sDimName, sPeriod, 'TM1 Serial');
ElementAttrPutN( first_day_tm1_serial, sDimName, sDimName, sPeriod, 'First Day TM1 Serial');
ElementAttrPutN( last_day_tm1_serial, sDimName, sDimName, sPeriod, 'Last Day TM1 Serial');
ElementAttrPutN( excel_serial, sDimName, sDimName, sPeriod, 'Excel Serial');
ElementAttrPutN( first_day_excel_serial, sDimName, sDimName, sPeriod, 'First Day Excel Serial');
ElementAttrPutN( last_day_excel_serial, sDimName, sDimName, sPeriod, 'Last Day Excel Serial');


#endregion