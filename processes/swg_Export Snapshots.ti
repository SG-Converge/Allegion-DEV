sCubeName = 'BS Input';
sViewName = 'sys.All Data ' | sCubeName;
sFilename = sFileDir | sCubeName | '.txt';
ExecuteProcess( 'sys_View - Create', 'pCubeName', sCubeName, 'pViewName', sViewName, 'pUseTemporaryObjects', 1, 'pMemberExpr1', sScenarios );
ExecuteProcess( 'sys_Cube - Data Export', 'pFilename', sFilename, 'pCubeName', sCubeName, 'pViewName', sViewName, 'pRecordFormat', 'tab', 'pOverwriteFile', 1 );
ExecuteProcess( 'sys_View - Delete', 'pCubeName', sCubeName, 'pViewName', sViewName);

sCubeName = 'BS Reporting';
sViewName = 'sys.All Data ' | sCubeName;
