#region Prolog

sScenarios = 'MDX:{
    DESCENDANTS([Scenario].[Scenario].[Scenarios] , 99 , LEAVES),
    DESCENDANTS([Scenario].[Scenario].[Snapshots] , 99 , LEAVES)
}';

sFileDir = '..\Exports\Scenario Data - ';

# sCubeName = 'Bridge Input';
# sViewName = 'sys.All Data ' | sCubeName;
