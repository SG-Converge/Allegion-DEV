# -------------------------------------------------------------
# Other Calculations
# -------------------------------------------------------------

# --- ACF_to_NETEARN
['ACF_to_NETEARN'] =  
    ['S_ACF'] \ ['NETEARN'];

# --- Carry over the ending backlog from the prior period and bring that 
# --- into the opening backlog
['S_BeginningBacklog'] = 
  If( SUBST( !Period, 6, 2 ) @= '01',
      ['S_OpenBacklog'],
      DB( 'PL Input', !Scenario, ATTRS( 'Period XRef', !Period, 'Period Prior' ), !Entity, !Product, !Function, 'S_Backlog', !PL Input Measure )
  );

# --- Direct variable costs expenses
['DIR_VAR_COST_EXPENSES', 'NoFunction'] = N: 
   ['600100', '10000'] + ['600100', '15000'] + ['600200', '10000'] + ['600200', '15000'];

# --- Fixed cost expenses
['FIXED_COST_EXPENSES', 'NoFunction'] = N: 
   ['600100', '73000'] + ['600100', '50000'] + ['600100', '30000'] + ['600100', '20000'] + ['600200', '20000'] + ['600200', '50000'];
 

# -------------------------------------------------------------
# Function Mapping to PL Accounts
# -------------------------------------------------------------

# -------------------------------------------------------------
#      UPDATE FORMAT IF CONFIGURABLE NUMBER OF SCENARIOS
#
# Use this format if going to multiple planning (and variable list)
# of scenarios that are live.
#
# ['MFGDIRECT', '10000'] = N: 
#     If( ELISANC('Scenario', 'Scenarios', !Scenario) = 1 % (!Scenario @= 'ACTUAL' & !PL Input Measure @= 'Reorg Amount'),
#         ['600100'],
#         CONTINUE
#     );
# -------------------------------------------------------------


# -------------------------------------------------------------
# SG&A for ACTUAL scenario during REORGANIZATONS
# -------------------------------------------------------------

['MFGDIRECT', '10000', 'Actual', 'Reorg Amount'] = N: 
    ['600100'];

['MFGINDIRECT', 'Actual', 'Reorg Amount'] = N: 
    If( ELISANC('Function', '20000', !Function) = 1,
        ['600100'],
        CONTINUE
    );

['DISTRIBUTION', 'Actual', 'Reorg Amount'] = N: 
    If( ELISANC('Function', '50000', !Function) = 1,
        ['600100'],
        CONTINUE
    );

['ENGINEERING', '73000', 'Actual', 'Reorg Amount'] = N: 
    ['600100'];

['SERVICEA', 'Actual', 'Reorg Amount'] = N: 
    If( ELISANC('Function', 'T_30000', !Function) = 1,
        ['600100'],
        CONTINUE
    );

['VARINDIRECT', '15000', 'Actual', 'Reorg Amount'] = N: 
    ['600100'];

['SELLING', 'Actual', 'Reorg Amount'] = N: 
    If( ELISANC('Function', 'T_90000', !Function) = 1,
        ['600100'],
        CONTINUE
    );

['ENGINEERING_SGA', 'Actual', 'Reorg Amount'] = N: 
    If( ELISANC('Function', 'T_72000', !Function) = 1 % !Function @= '71000',
        ['600100'],
        CONTINUE
    );

['GA', 'Actual', 'Reorg Amount'] = N: 
    If( ELISANC('Function', '80000', !Function) = 1,
        ['600100'],
        CONTINUE
    );

['QUALRESTCOST', 'Actual', 'Reorg Amount'] = N: 
    If( !Function @= '10000' % !Function @= '15000' % !Function @= '73000'
          % ELISANC('Function', '20000', !Function) = 1
          % ELISANC('Function', '30000', !Function) = 1
          % ELISANC('Function', '50000', !Function) = 1,
        ['640120'],
        CONTINUE
    );

['NONQUALRESTCOST', 'Actual', 'Reorg Amount'] = N: 
    If( !Function @= '10000' % !Function @= '15000' % !Function @= '73000'
          % ELISANC('Function', '20000', !Function) = 1
          % ELISANC('Function', '30000', !Function) = 1
          % ELISANC('Function', '50000', !Function) = 1,
        ['640130'],
        CONTINUE
    );

['QUALRESTSGA', 'Actual', 'Reorg Amount'] = N: 
    If( !Function @= '71000'
          % ELISANC('Function', 'T_72000', !Function) = 1
          % ELISANC('Function', '80000', !Function) = 1
          % ELISANC('Function', 'T_90000', !Function) = 1,
        ['640120'],
        CONTINUE
    );

['NONQUALRESTSGA', 'Actual', 'Reorg Amount'] = N: 
    If( !Function @= '71000'
          % ELISANC('Function', 'T_72000', !Function) = 1
          % ELISANC('Function', '80000', !Function) = 1
          % ELISANC('Function', 'T_90000', !Function) = 1,
        ['640130'],
        CONTINUE
    );

['MACOST', 'Actual', 'Reorg Amount'] = N: 
    If( !Function @= '10000' % !Function @= '15000' % !Function @= '73000'
          % ELISANC('Function', '20000', !Function) = 1
          % ELISANC('Function', 'T_30000', !Function) = 1
          % ELISANC('Function', '50000', !Function) = 1,
        ['600400'],
        CONTINUE
    );

['MASGA', 'Actual', 'Reorg Amount'] = N: 
    If( !Function @= '71000'
          % ELISANC('Function', 'T_72000', !Function) = 1
          % ELISANC('Function', '80000', !Function) = 1
          % ELISANC('Function', 'T_90000', !Function) = 1,
        ['600400'],
        CONTINUE
    );

['Actual'] = N: STET;

# -------------------------------------------------------------
# SG&A for FORECAST scenarios
# -------------------------------------------------------------

['MFGDIRECT', '10000'] = N: 
    ['600100'];

['MFGINDIRECT'] = N: 
    If( ELISANC('Function', '20000', !Function) = 1,
        ['600100'],
        CONTINUE
    );

['DISTRIBUTION'] = N: 
    If( ELISANC('Function', '50000', !Function) = 1,
        ['600100'],
        CONTINUE
    );

['ENGINEERING', '73000'] = N: 
    ['600100'];

['SERVICEA'] = N: 
    If( ELISANC('Function', 'T_30000', !Function) = 1,
        ['600100'],
        CONTINUE
    );

['VARINDIRECT', '15000'] = N: 
    ['600100'];

['SELLING'] = N: 
    If( ELISANC('Function', 'T_90000', !Function) = 1,
        ['600100'],
        CONTINUE
    );

['ENGINEERING_SGA'] = N: 
    If( ELISANC('Function', 'T_72000', !Function) = 1 % !Function @= '71000',
        ['600100'],
        CONTINUE
    );

['GA'] = N: 
    If( ELISANC('Function', '80000', !Function) = 1,
        ['600100'],
        CONTINUE
    );

['QUALRESTCOST'] = N: 
    If( !Function @= '10000' % !Function @= '15000' % !Function @= '73000'
          % ELISANC('Function', '20000', !Function) = 1
          % ELISANC('Function', '30000', !Function) = 1
          % ELISANC('Function', '50000', !Function) = 1,
        ['640120'],
        CONTINUE
    );

['NONQUALRESTCOST'] = N: 
    If( !Function @= '10000' % !Function @= '15000' % !Function @= '73000'
          % ELISANC('Function', '20000', !Function) = 1
          % ELISANC('Function', '30000', !Function) = 1
          % ELISANC('Function', '50000', !Function) = 1,
        ['640130'],
        CONTINUE
    );

['QUALRESTSGA'] = N: 
    If( !Function @= '71000'
          % ELISANC('Function', 'T_72000', !Function) = 1
          % ELISANC('Function', '80000', !Function) = 1
          % ELISANC('Function', 'T_90000', !Function) = 1,
        ['640120'],
        CONTINUE
    );

['NONQUALRESTSGA'] = N: 
    If( !Function @= '71000'
          % ELISANC('Function', 'T_72000', !Function) = 1
          % ELISANC('Function', '80000', !Function) = 1
          % ELISANC('Function', 'T_90000', !Function) = 1,
        ['640130'],
        CONTINUE
    );

['MACOST'] = N: 
    If( !Function @= '10000' % !Function @= '15000' % !Function @= '73000'
          % ELISANC('Function', '20000', !Function) = 1
          % ELISANC('Function', 'T_30000', !Function) = 1
          % ELISANC('Function', '50000', !Function) = 1,
        ['600400'],
        CONTINUE
    );

['MASGA'] = N: 
    If( !Function @= '71000'
          % ELISANC('Function', 'T_72000', !Function) = 1
          % ELISANC('Function', '80000', !Function) = 1
          % ELISANC('Function', 'T_90000', !Function) = 1,
        ['600400'],
        CONTINUE
    );




FEEDERS;

# -------------------------------------------------------------
#                          TEMPORARY
#            TO BE REMOVED AFTER COPY STATIC VALUES
#
# For 2026 and beyond, second submit (reorgs) will be entered
# manually.   Historically, however, they are to be calcualted
# from a load from HFM that contains ending balances.
# -------------------------------------------------------------
['Actual', 'Historical Reorg Delta'] => ['Reorg Amount'];

  
['Actual'] =>
  DB( If( !Period @>= DB( 'Global Assumptions', 'Working Forecast Horizon Start Year', 'String'),
        'PL Input', 
        '*** No Feed ***'
      ),
      'Working Forecast', !Period, !Entity, !Product, !Function, !PL Account, !PL Input Measure 
    );
  
['PL Input Measure':'Load Delta'] => ['PL Input Measure':'Standard Adjustment'];

# --- Basic shares are the driver for CO, DO and TOT EPS
# ['89000010', 'S_BASIC_SHARES_MTD'] => 
#   ['MANAGEMENT', 'BASIC_EPS_CO_MTD'], ['MANAGEMENT', 'BASIC_EPS_DO_MTD'], ['MANAGEMENT', 'BASIC_EPS_TOT_MTD'];
# ['89000010', 'S_BASIC_SHARES_QTD'] => 
#   ['MANAGEMENT', 'BASIC_EPS_CO_QTD'], ['MANAGEMENT', 'BASIC_EPS_DO_QTD'], ['MANAGEMENT', 'BASIC_EPS_TOT_QTD'];
# ['89000010', 'S_BASIC_SHARES_YTD'] => 
#   ['MANAGEMENT', 'BASIC_EPS_CO_YTD'], ['MANAGEMENT', 'BASIC_EPS_DO_YTD'], ['MANAGEMENT', 'BASIC_EPS_TOT_YTD'];

# # --- Diluted shares are the driver for CO, DO and TOT EPS
# ['89000010', 'S_DILUTED_SHARES_MTD'] => 
#   ['MANAGEMENT', 'DILUTED_EPS_CO_MTD'], ['MANAGEMENT', 'DILUTED_EPS_DO_MTD'], ['MANAGEMENT', 'DILUTED_EPS_TOT_MTD'];
# ['89000010', 'S_DILUTED_SHARES_QTD'] => 
#   ['MANAGEMENT', 'DILUTED_EPS_CO_QTD'], ['MANAGEMENT', 'DILUTED_EPS_DO_QTD'], ['MANAGEMENT', 'DILUTED_EPS_TOT_QTD'];
# ['89000010', 'S_DILUTED_SHARES_YTD'] => 
#   ['MANAGEMENT', 'DILUTED_EPS_CO_YTD'], ['MANAGEMENT', 'DILUTED_EPS_DO_YTD'], ['MANAGEMENT', 'DILUTED_EPS_TOT_YTD'];

# --- ACF to Net Earnings
['S_ACF', {'Actual','Scenarios'}] =>
  ['ACF_to_NETEARN'];

# --- Current backlog feeds next period backlog to carry balances forward
['S_Backlog', {'Actual','Scenarios'}] =>
 DB( 'PL Input', !Scenario, ATTRS( 'Period XRef', !Period, 'Period Next' ), 
     !Entity, !Product, !Function, !PL Account, !PL Input Measure );

['S_OpenBacklog', 'Actual'] =>
  ['S_BeginningBacklog'];
  
# --- Feed beginning backlog for Working AOP
['S_BeginningBacklog','Working Forecast'] =>
  DB( If( !Period @= DB('Global Assumptions', 'Working AOP Seed Period', 'String' ), 'PL Input', '*** NO FEED ***'),
      'Working AOP', DB( 'Global Assumptions', 'Working AOP Start Year', 'String' ) | '-01', 
      !Entity, !Product, !Function, !PL Account, !PL Input Measure );

  

# --- Feed the Direct Variable Cost Expenses
['600100', '10000', {'Actual', 'Scenarios'}] => ['DIR_VAR_COST_EXPENSES', 'NoFunction'];
['600100', '15000', {'Actual', 'Scenarios'}] => ['DIR_VAR_COST_EXPENSES', 'NoFunction'];
['600200', '10000', {'Actual', 'Scenarios'}] => ['DIR_VAR_COST_EXPENSES', 'NoFunction'];
['600200', '15000', {'Actual', 'Scenarios'}] => ['DIR_VAR_COST_EXPENSES', 'NoFunction'];

# --- Feed the Fixed Cost Expenses
['600100', '73000', {'Actual', 'Scenarios'}] => ['FIXED_COST_EXPENSES', 'NoFunction'];
['600100', '50000', {'Actual', 'Scenarios'}] => ['FIXED_COST_EXPENSES', 'NoFunction'];
['600100', '30000', {'Actual', 'Scenarios'}] => ['FIXED_COST_EXPENSES', 'NoFunction'];
['600100', '20000', {'Actual', 'Scenarios'}] => ['FIXED_COST_EXPENSES', 'NoFunction'];
['600200', '20000', {'Actual', 'Scenarios'}] => ['FIXED_COST_EXPENSES', 'NoFunction'];
['600200', '50000', {'Actual', 'Scenarios'}] => ['FIXED_COST_EXPENSES', 'NoFunction'];

# -------------------------------------------------------------
# Balance Sheet feeders for asset accounts
# -------------------------------------------------------------
[{'Working Forecast', 'Working AOP' }, '692000','Reported Amount'] => 
  DB('BS Input', !Scenario, !Period, !Entity, !Product, '175000_ADD', 'Amount');

[{'Working Forecast', 'Working AOP' }, '514102','Reported Amount'] => 
  DB('BS Input', !Scenario, !Period, !Entity, !Product, '175000_ADD', 'Reported Amount');

[{'Working Forecast', 'Working AOP' }, '640320','Reported Amount'] => 
  DB('BS Input', !Scenario, !Period, !Entity, !Product, '181000_ADD', 'Reported Amount');

[{'Working Forecast', 'Working AOP' }, '640330','Reported Amount'] => 
  DB('BS Input', !Scenario, !Period, !Entity, !Product, '181100_ADD', 'Reported Amount');

  
# -------------------------------------------------------------
# Function Mapping to PL Accounts for FORECAST
# -------------------------------------------------------------
['600100', '10000', {'Scenarios', 'Snapshots' }] =>
    ['MFGDIRECT'];

['600100', {'Scenarios', 'Snapshots' }] =>
    DB(
        IF(ELISANC('Function', '20000', !Function) = 1, 'PL Input', '*** No Feed ***'),
        !Scenario, !Period, !Entity, !Product, !Function, 
            'MFGINDIRECT', !PL Input Measure
    );

['600100', {'Scenarios', 'Snapshots' }] =>
    DB(
        IF(ELISANC('Function', '50000', !Function) = 1, 'PL Input', '*** No Feed ***'),
        !Scenario, !Period, !Entity, !Product, !Function, 
            'DISTRIBUTION', !PL Input Measure
    );

['600100', '73000', {'Scenarios', 'Snapshots' }] =>
    ['ENGINEERING'];

['600100', {'Scenarios', 'Snapshots' }] =>
    DB(
        IF(ELISANC('Function', 'T_30000', !Function) = 1, 'PL Input', '*** No Feed ***'),
        !Scenario, !Period, !Entity, !Product, !Function,
            'SERVICEA', !PL Input Measure
    );

['600100', '15000', {'Scenarios', 'Snapshots' }] =>
    ['VARINDIRECT'];

['600100', {'Scenarios', 'Snapshots' }] =>
    DB(
        IF(ELISANC('Function', 'T_90000', !Function) = 1, 'PL Input', '*** No Feed ***'),
        !Scenario, !Period, !Entity, !Product, !Function,
            'SELLING', !PL Input Measure
    );

['600100', {'Scenarios', 'Snapshots' }] =>
    DB(
        IF(ELISANC('Function', 'T_72000', !Function) = 1 % !Function @= '71000', 'PL Input', '*** No Feed ***'),
        !Scenario, !Period, !Entity, !Product, !Function,
            'ENGINEERING_SGA', !PL Input Measure
    );

['600100', {'Scenarios', 'Snapshots' }] =>
    DB(
        IF(ELISANC('Function', '80000', !Function) = 1, 'PL Input', '*** No Feed ***'),
        !Scenario, !Period, !Entity, !Product, !Function,
            'GA', !PL Input Measure
    );

['640120', {'Scenarios', 'Snapshots' }] =>
    DB(
        IF( !Function @= '10000' % !Function @= '15000' % !Function @= '73000'
                % ELISANC('Function', '20000', !Function) = 1
                % ELISANC('Function', '30000', !Function) = 1
                % ELISANC('Function', '50000', !Function) = 1,
            'PL Input', 
            '*** No Feed ***'
        ),
        !Scenario, !Period, !Entity, !Product, !Function,
            'QUALRESTCOST', !PL Input Measure
    );

['640130', {'Scenarios', 'Snapshots' }] =>
    DB(
        IF( !Function @= '10000' % !Function @= '15000' % !Function @= '73000'
                % ELISANC('Function', '20000', !Function) = 1
                % ELISANC('Function', '30000', !Function) = 1
                % ELISANC('Function', '50000', !Function) = 1,
            'PL Input', 
            '*** No Feed ***'
        ),
        !Scenario, !Period, !Entity, !Product, !Function,
            'NONQUALRESTCOST', !PL Input Measure
    );

['640120', {'Scenarios', 'Snapshots' }] =>
    DB(
        IF( !Function @= '71000'
                % ELISANC('Function', 'T_72000', !Function) = 1
                % ELISANC('Function', '80000', !Function) = 1
                % ELISANC('Function', 'T_90000', !Function) = 1,
            'PL Input', 
            '*** No Feed ***'
        ),
        !Scenario, !Period, !Entity, !Product, !Function,
            'QUALRESTSGA', !PL Input Measure
    );

['640130', {'Scenarios', 'Snapshots' }] =>
    DB(
        IF( !Function @= '71000'
                % ELISANC('Function', 'T_72000', !Function) = 1
                % ELISANC('Function', '80000', !Function) = 1
                % ELISANC('Function', 'T_90000', !Function) = 1,
            'PL Input', 
            '*** No Feed ***'
        ),
        !Scenario, !Period, !Entity, !Product, !Function,
            'NONQUALRESTSGA', !PL Input Measure
    );

['600400', {'Scenarios', 'Snapshots' }] =>
    DB(
        IF( !Function @= '10000' % !Function @= '15000' % !Function @= '73000'
                % ELISANC('Function', '20000', !Function) = 1
                % ELISANC('Function', 'T_30000', !Function) = 1
                % ELISANC('Function', '50000', !Function) = 1,
            'PL Input', 
            '*** No Feed ***'
        ),
        !Scenario, !Period, !Entity, !Product, !Function,
            'MACOST', !PL Input Measure
    );

['600400', {'Scenarios', 'Snapshots' }] =>
    DB( 
        IF( !Function @= '71000'
                % ELISANC('Function', 'T_72000', !Function) = 1
                % ELISANC('Function', '80000', !Function) = 1
                % ELISANC('Function', 'T_90000', !Function) = 1,
            'PL Input', 
            '*** No Feed ***'
        ),
        !Scenario, !Period, !Entity, !Product, !Function,
            'MASGA', !PL Input Measure
    );

  

  
