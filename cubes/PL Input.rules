# -------------------------------------------------------------
# Forecast Input to Reporting feeder
# -------------------------------------------------------------
['Scenarios'] =>
  DB( 'PL Reporting', !Scenario, !Period, 'Local', !Entity, !Product, !Function, !PL Account, !PL Input Measure );
