SKIPCHECK;

# -------------------------------------------------------------
# Deactivate calculations for all static scenarios
# -------------------------------------------------------------
# --- Snapshots and constant currency scenarios are not calculated here
[] = N:
  If( !Scenario @= 'Actual' % ELISANC( 'Scenario', 'Scenarios', !Scenario ) = 1,
    CONTINUE,
    STET
  );


# -------------------------------------------------------------
# Actual periods of working forecast should be from Actuals
# -------------------------------------------------------------
['Working Forecast'] = N:
  If( !Period @> DB('Global Assumptions', 'Actual End Period', 'String' ),
    CONTINUE,
    If( !Period @< DB( 'Global Assumptions', 'Working Forecast Horizon Start Year', 'String' ),
      CONTINUE,
      ['Actual']
    )
  );

# -------------------------------------------------------------
#                          TEMPORARY
#            TO BE REMOVED AFTER COPY STATIC VALUES
# For 2026 and beyond, second submit (reorgs) will be entered
# manually.   Historically, however, they are to be calcualted
# from a load from HFM that contains ending balances.
# -------------------------------------------------------------
['Actual','Reorg Amount'] = N:
  If( SUBST( !Period, 1, 4 ) @> '2025',
    STET,
    ['Historical Reorg Delta']
  );
['Reorg Amount'] = N: 0;
['Historical Reorg Amount'] = N:
  If( SUBST( !Period, 1, 4 ) @> '2025',
    0,
    CONTINUE
  );


# --- RO Data comes from RO Reporting.   No calculations apply here
[{'Working RO', 'RO 3+9','RO 6+6','RO 9+3'}, 'Reported Amount'] = N:
  DB('RO Reporting', !Scenario, SUBST(!Period, 1, 4), 'Local', 'All Types', !Entity, 
     !Product, !Function, !PL Account, 'All RO Items', 'All Categories', 
     SUBST(!Period, 6, 2)
  );

# --- Prevent input anywhere else within RO scenarios.
[{'Working RO', 'RO 3+9','RO 6+6','RO 9+3'}] = N: 0;
  
# --- Standard adjustment is always calculated.  Data entry is put in
# --- One-Time adjustments.
[{'Actual', 'Working Forecast'},'Standard Adjustment'] = N:
  ['PL Input Measure':'Load Delta'];

['s_Backlog'] =
  ['S_BeginningBacklog'] + ['S_NetBookings'] + ['S_BackLogAdj'] +
  ['S_BacklogTran'] - ['410000'];

# -----05/18/2026 - RJL - Add for S_Backlog
# --- Balance type accounts need to look back at the last month of the 
# --- period rather than aggregating.
['S_BeginningBacklog','Actual'] = C:
    If( ELLEV( 'Period', !Period ) > 0,
      If( SUBST( !Period, 1, 4 ) @> SUBST( DB('Global Assumptions', 'Actual End Period', 'String' ), 1, 4 ),
        0,
        If( SCAN( 'TD', !Period ) > 0,
            DB( 'PL Input', !Scenario, SUBST( !Period, 1, 7 ), !Entity, !Product, !Function, !PL Account, !PL Input Measure ),
            DB( 'PL Input', !Scenario, ATTRS( 'Period XRef', !Period, 'Period Beginning Month' ), !Entity, !Product, !Function, !PL Account, !PL Input Measure )
        )
      ),
      CONTINUE
    );

# --- 09/09/2026 - SWG - Added for AOP beginning backlog
# --- Special seeding for Working AOP
['S_BeginningBacklog', 'Working AOP'] = 
  If( !Period @= DB( 'Global Assumptions', 'Working AOP Start Year', 'String' ) | '-01',
    DB('PL Input', 'Working Forecast', DB('Global Assumptions', 'Working AOP Seed Period', 'String' ), 
       !Entity, !Product, !Function, !PL Account, !PL Input Measure ),
    CONTINUE
  );


# --- Balance type accounts need to look back at the last month of the 
# --- period rather than aggregating.
# --- NRR updated rule 2026-09-24.  The rule below that is commented out will be removed after testing.
 ['Actual'] = C:
  If( ATTRS( 'PL Account', !PL Account, 'Time Balance' ) @= 'balance' &  ELLEV( 'Period', !Period ) > 0,
	 
      If(ELISANC( 'Period', !Period, DB('Global Assumptions', 'Actual End Period', 'String' ) )= 1,
          DB( 'PL Input', !Scenario, DB('Global Assumptions', 'Actual End Period', 'String' ), !Entity, !Product, !Function, !PL Account, !PL Input Measure ),
		  
		  IF( SCAN( 'TD', !Period ) > 0,
              DB( 'PL Input', !Scenario, SUBST( !Period, 1, 7 ), !Entity, !Product, !Function, !PL Account, !PL Input Measure ),
              DB( 'PL Input', !Scenario, ATTRS( 'Period XRef', !Period, 'Period Ending Month' ), !Entity, !Product, !Function, !PL Account, !PL Input Measure )
			)
		),
	CONTINUE
  );




# --- Balance type accounts need to look back at the last month of the 
# --- period rather than aggregating.
#['Actual'] = C:
#  If( ATTRS( 'PL Account', !PL Account, 'Time Balance' ) @= 'balance',
#    If( ELLEV( 'Period', !Period ) > 0,
#      If( SUBST( !Period, 1, 4 ) @> SUBST( DB('Global Assumptions', 'Actual End Period', 'String' ), 1, 4 ),
#        0,
#        If( !Period @> DB('Global Assumptions', 'Actual End Period', 'String' ) % !Period @= SUBST( DB('Global Assumptions', 'Actual End Period', 'String' ), 1, 4 ),
#          DB( 'PL Input', !Scenario, DB('Global Assumptions', 'Actual End Period', 'String' ), !Entity, !Product, !Function, !PL Account, !PL Input Measure ),
#          If( SCAN( 'TD', !Period ) > 0,
#              DB( 'PL Input', !Scenario, SUBST( !Period, 1, 7 ), !Entity, !Product, !Function, !PL Account, !PL Input Measure ),
#              DB( 'PL Input', !Scenario, ATTRS( 'Period XRef', !Period, 'Period Ending Month' ), !Entity, !Product, !Function, !PL Account, !PL Input Measure )
#          )
#        )
#      ),
#      CONTINUE
#    ),
#    CONTINUE
#  );

# -----05/18/2026 - RJL - Add for S_Backlog
# --- Balance type accounts need to look back at the last month of the 
# --- period rather than aggregating.
['S_BeginningBacklog'] = C:
  If( ATTRS( 'PL Account', !PL Account, 'Time Balance' ) @= 'balance',
    If( ELLEV( 'Period', !Period ) > 0,
      If( SCAN( 'TD', !Period ) > 0,
          DB( 'PL Input', !Scenario, SUBST( !Period, 1, 7 ), !Entity, !Product, !Function, !PL Account, !PL Input Measure ),
          DB( 'PL Input', !Scenario, ATTRS( 'Period XRef', !Period, 'Period Beginning Month' ), !Entity, !Product, !Function, !PL Account, !PL Input Measure )
      ),
      CONTINUE
    ),
    CONTINUE
  );

# --- Balance type accounts need to look back at the last month of the 
# --- period rather than aggregating.
[] = C:
  If( ATTRS( 'PL Account', !PL Account, 'Time Balance' ) @= 'balance',
    If( ELLEV( 'Period', !Period ) > 0,
      If( SCAN( 'TD', !Period ) > 0,
          DB( 'PL Input', !Scenario, SUBST( !Period, 1, 7 ), !Entity, !Product, !Function, !PL Account, !PL Input Measure ),
          DB( 'PL Input', !Scenario, ATTRS( 'Period XRef', !Period, 'Period Ending Month' ), !Entity, !Product, !Function, !PL Account, !PL Input Measure )
      ),
      CONTINUE
    ),
    CONTINUE
  );

